{
  "manifest_version": 3,
  "name": "쇼크트리AI",
  "short_name": "쇼크트리AI",
  "version": "1.1.1",
  "description": "훈프로에서 버튼 한 번으로 쿠팡 윙의 경쟁 상품 판매 데이터와 광고센터 광고비 보고서를 가져옵니다.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "쇼크트리AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://wing.coupang.com/*",
    "https://advertising.coupang.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hoonproai.com/*",
        "https://www.hoonproai.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}