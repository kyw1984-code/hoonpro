GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
VITE_REMOVE_BG_API_KEY="YOUR_REMOVE_BG_API_KEY"

# OpenAI (서버리스에서만 사용, 브라우저에 노출되지 않음)
OPENAIAPIKEY="sk-..."
OPENAI_TEXT_MODEL="gpt-4.1-mini"     # 기획안/카피 생성
OPENAI_IMAGE_MODEL="gpt-image-2"     # 이미지 생성 기본값, 필요 시 변경
OPENAI_IMAGE_QUALITY="medium"        # low | medium | high | auto

# Supabase (https://supabase.com 에서 프로젝트 생성 후 발급)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."   # Settings > API > service_role key

# JWT 서명 비밀키 (임의의 긴 문자열 사용)
JWT_SECRET="여기에-랜덤-긴-문자열-입력"

# 관리자 이메일 (이 이메일로 로그인하면 관리자 권한 부여)
ADMIN_EMAIL="admin@example.com"

# ─── 소싱 파인더 (api/sourcing.ts) ────────────────────────────────────────────
# 네이버 개발자센터 키 (검색 API). 쇼핑 검색은 NAVER API HUB로 이관되어
# openapi.naver.com 에서는 SE05(존재하지 않는 검색 api)를 반환한다.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# NAVER API HUB(NAVER Cloud Platform)로 이관한 경우 — 발급받은 호출 정보로 교체
# NAVER_API_BASE_URL="https://openapi.naver.com"   # HUB 게이트웨이 주소로 변경
# NAVER_APIGW_API_KEY_ID=""
# NAVER_APIGW_API_KEY=""

# 쿠팡 리뷰 수 보강용 쿠키(선택)
COUPANG_COOKIE=""
