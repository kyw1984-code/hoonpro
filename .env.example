GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
VITE_REMOVE_BG_API_KEY="YOUR_REMOVE_BG_API_KEY"

# OpenAI (서버리스에서만 사용, 브라우저에 노출되지 않음)
OPENAIAPIKEY="sk-..."
OPENAI_TEXT_MODEL="gpt-4.1-mini"     # 기획안/카피 생성
OPENAI_IMAGE_MODEL="gpt-image-2"     # 이미지 생성 기본값, 필요 시 변경
OPENAI_IMAGE_QUALITY="medium"        # low | medium | high | auto

# Supabase (https://supabase.com 에서 프로젝트 생성 후 발급)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY="eyJ..."   # Settings > API > service_role key

# JWT 서명 비밀키 (임의의 긴 문자열 사용)
JWT_SECRET="여기에-랜덤-긴-문자열-입력"

# 관리자 이메일 (이 이메일로 로그인하면 관리자 권한 부여)
ADMIN_EMAIL="admin@example.com"

# 네이버 검색광고 API (searchad.naver.com → 도구 → API 사용관리에서 무료 발급)
NAVER_AD_API_KEY="네이버_검색광고_액세스라이선스"
NAVER_AD_SECRET_KEY="네이버_검색광고_비밀키"
NAVER_AD_CUSTOMER_ID="네이버_검색광고_CUSTOMER_ID"

# Bright Data Web Unlocker (쿠팡 실시간 수집 — brightdata.com 대시보드에서 Unlocker 존 생성)
BRIGHTDATA_API_TOKEN="브라이트데이터_API_토큰"
BRIGHTDATA_UNLOCKER_ZONE="web_unlocker1"

# Vercel Cron 인증 (임의의 긴 랜덤 문자열 — 관심 키워드 자동 추적용)
CRON_SECRET="랜덤_긴_문자열"
