{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; fi; exit 0",
  "crons": [
    {
      "path": "/api/sourcing?type=cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/billing?action=charge-due",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/coupang?action=cron&type=sync",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/coupang?action=cron&type=daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/coupang?action=cron&type=weekly",
      "schedule": "0 23 * * 0"
    }
  ],
  "functions": {
    "api/qa.ts": {
      "maxDuration": 60
    },
    "api/sourcing.ts": {
      "maxDuration": 300
    },
    "api/billing.ts": {
      "maxDuration": 300
    },
    "api/coupang.ts": {
      "maxDuration": 300
    }
  }
}
